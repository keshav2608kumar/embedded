<mxfile host="app.diagrams.net" modified="2026-10-27T12:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="fsm_diagram" name="Gate Moore FSM">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="System Behavior: Moore Gate Finite State Machine (FSM)&#xa;Six States · One Safe State (FAULT_SAFE) · Outputs Depend Strictly on Current State" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="750" height="40" as="geometry" />
        </mxCell>

        <!-- STATE 1: CLOSED -->
        <mxCell id="st_closed" value="CLOSED&#xa;────────────────&#xa;• Servo: 0° (Barrier Down)&#xa;• LCD: GATE: CLOSED&#xa;• Safe Default State" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#1e293b;strokeWidth=2.5;fontColor=#0f172a;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 2: OPENING -->
        <mxCell id="st_opening" value="OPENING&#xa;────────────────&#xa;• Servo: Sweeping 0° → 90°&#xa;• LCD: GATE: OPENING&#xa;• Travel Timer: 1.5s" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 3: OPEN -->
        <mxCell id="st_open" value="OPEN&#xa;────────────────&#xa;• Servo: 90° (Barrier Up)&#xa;• LCD: GATE: OPEN&#xa;• 10s Auto-Close Timer Active" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2.5;fontColor=#064e3b;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 4: VEHICLE_PASSING -->
        <mxCell id="st_passing" value="VEHICLE_PASSING&#xa;────────────────&#xa;• Servo: 90° Held&#xa;• IR Sensor Active&#xa;• Timer Continuously Resets" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="440" width="185" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 5: CLOSING -->
        <mxCell id="st_closing" value="CLOSING&#xa;────────────────&#xa;• Servo: Sweeping 90° → 0°&#xa;• LCD: GATE: CLOSING&#xa;• Safety Override Armed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#881337;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 6: FAULT_SAFE -->
        <mxCell id="st_fault" value="FAULT_SAFE&#xa;────────────────&#xa;• Servo: 0° Firmly Locked&#xa;• Inhibit New Entry&#xa;• LCD: SYSTEM OFFLINE&#xa;• Bounded Buzzer Alarm" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#000000;strokeWidth=2.5;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="430" y="660" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- TRANSITIONS -->

        <!-- CLOSED -> OPENING -->
        <mxCell id="t1" edge="1" parent="1" source="st_closed" target="st_opening" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#059669;exitX=0.5;exitY=0;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="188" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t1_lbl" value="Entry Request [IR Sensor Active]&#xa;AND Valid Packet AND Free Slots &gt; 0" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;fontStyle=1;fontColor=#065f46;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t1">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="15" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- OPENING -> OPEN -->
        <mxCell id="t2" edge="1" parent="1" source="st_opening" target="st_open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563eb;exitX=1;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="188" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t2_lbl" value="Gate Fully Open Reached&#xa;[Travel Time 1.5s Elapsed]" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;fontStyle=1;fontColor=#1e40af;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t2">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="-15" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- OPEN -> VEHICLE_PASSING -->
        <mxCell id="t3" edge="1" parent="1" source="st_open" target="st_passing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d97706;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t3_lbl" value="Vehicle Detected at Gate&#xa;[IR Beam Broken]" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#b45309;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t3">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="2" y="2" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- VEHICLE_PASSING -> CLOSING -->
        <mxCell id="t4" edge="1" parent="1" source="st_passing" target="st_closing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4_lbl" value="Sensor Clear (Debounced)&#xa;AND 10s Countdown Complete" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;fontStyle=1;fontColor=#334155;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t4">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="-5" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- CLOSING -> CLOSED -->
        <mxCell id="t5" edge="1" parent="1" source="st_closing" target="st_closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1e293b;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="488" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t5_lbl" value="Closed Position Reached (0°)&#xa;[Sensor Clear]" style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#0f172a;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t5">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="10" y="10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- CLOSING -> OPENING (CRITICAL SAFETY REVERSAL) -->
        <mxCell id="t6_reversal" edge="1" parent="1" source="st_closing" target="st_opening" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#dc2626;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6_lbl" value="SAFETY REVERSAL!&#xa;Obstacle detected during CLOSING&#xa;[Immediate Re-Open in &lt; 25 ms]" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#dc2626;backgroundColor=#ffffff;strokeColor=#dc2626;rounded=1;" vertex="1" connectable="0" parent="t6_reversal">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- CRITICAL FAULT TRANSITIONS TO FAULT_SAFE -->
        <mxCell id="t_fault1" edge="1" parent="1" source="st_closed" target="st_fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#64748b;dashed=1;exitX=0.2;exitY=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="136" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_fault1_lbl" value="Comm Timeout (15s)&#xa;or WDT Reset" style="text;html=1;align=center;verticalAlign=top;fontSize=9;fontStyle=0;fontColor=#475569;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t_fault1">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <mxPoint x="2" y="-5" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t_fault2" edge="1" parent="1" source="st_closing" target="st_fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#64748b;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FAULT_SAFE -> CLOSED (Recovery) -->
        <mxCell id="t_recov" edge="1" parent="1" source="st_fault" target="st_closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#059669;dashed=1;exitX=0.2;exitY=0;entryX=0.8;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="600" />
              <mxPoint x="244" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_recov_lbl" value="Fault Cleared AND Valid Packet Received&#xa;[Safe Re-arm]" style="text;html=1;align=center;verticalAlign=bottom;fontSize=9;fontStyle=1;fontColor=#065f46;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="t_recov">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="-20" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Safe State Annotation Box -->
        <mxCell id="safe_box" value="Safe State Specification:&#xa;• Safe State = FAULT_SAFE&#xa;• Gate firmly closed at 0° to inhibit entry&#xa;• Bounded audible buzzer warning&#xa;• LCD displays 'SYSTEM OFFLINE'&#xa;• Moore machine: outputs depend purely on state" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="650" width="260" height="110" as="geometry" />
        </mxCell>

      </root>
